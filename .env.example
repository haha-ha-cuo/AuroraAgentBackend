# ============================================================
# Aurora 环境变量示例
# 用法：复制为 .env 后填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# ---------- 模型接入（本地 API 管理层）----------
# 环境变量仅用于开发/测试注入；发布版由桌面壳 Rust 写入系统钥匙串，
# 本文件不参与生产密钥管理。
#
# 密钥只用于构造模型客户端：不进入图状态、不打印、不落日志、不写 SQLite。

# API 密钥（OpenAI 兼容端点必填；未设置时回退读 OPENAI_API_KEY）
AGENT_API_KEY=

# OpenAI 兼容端点 base_url
AGENT_BASE_URL=https://api.openai.com/v1

# 模型名
AGENT_MODEL=

# 说明：未配置密钥时进入 mock 模式（确定性输出、零 token 成本），
#      可跑通完整 demo 流程；配置密钥后走真实 API，
#      缺密钥不得静默回退（见 ADR-002）。

# ---------- 日志 ----------
# 级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（默认 INFO）
AURORA_LOG_LEVEL=INFO
